<?xml version = "1.0"?>
<!-- MQ2RustPluginTest's own window, for the selftest's plugin window checks
     (Mq::add_xml_file, Mq::add_window). Deployed to MacroQuest's
     resources/uifiles/default by scripts/deploy-plugin. -->
<XML ID = "EQInterfaceDefinitionLanguage">
<Schema xmlns = "EverQuestData" xmlns:dt = "EverQuestDataTypes"/>

<Label item = "RTW_Label">
	<ScreenID>RTW_Label</ScreenID>
	<Font>3</Font>
	<Text>mq-emu plugin window</Text>
	<TextColor> <R>255</R> <G>255</G> <B>255</B> </TextColor>
	<Location> <X>8</X> <Y>6</Y> </Location>
	<Size> <CX>180</CX> <CY>16</CY> </Size>
	<AlignCenter>false</AlignCenter>
</Label>

<Editbox item = "RTW_Input">
	<ScreenID>RTW_Input</ScreenID>
	<DrawTemplate>WDT_Inner</DrawTemplate>
	<Location> <X>8</X> <Y>26</Y> </Location>
	<Size> <CX>180</CX> <CY>18</CY> </Size>
	<Style_Border>true</Style_Border>
	<TextColor> <R>255</R> <G>255</G> <B>255</B> </TextColor>
</Editbox>

<Button item = "RTW_Button">
	<ScreenID>RTW_Button</ScreenID>
	<Location> <X>8</X> <Y>50</Y> </Location>
	<Size> <CX>80</CX> <CY>20</CY> </Size>
	<Text>Press</Text>
	<Style_VScroll>false</Style_VScroll>
	<Style_HScroll>false</Style_HScroll>
	<Style_Transparent>false</Style_Transparent>
	<Style_Checkbox>false</Style_Checkbox>
	<TextColor> <R>255</R> <G>255</G> <B>255</B> </TextColor>
	<ButtonDrawTemplate>
		<Normal>A_BtnNormal</Normal>
		<Pressed>A_BtnPressed</Pressed>
		<Flyby>A_BtnFlyby</Flyby>
		<Disabled>A_BtnDisabled</Disabled>
		<PressedFlyby>A_BtnPressedFlyby</PressedFlyby>
	</ButtonDrawTemplate>
</Button>

<Screen item = "RustTestWnd">
	<RelativePosition>false</RelativePosition>
	<Location> <X>200</X> <Y>200</Y> </Location>
	<Size> <CX>210</CX> <CY>100</CY> </Size>
	<Text>mq-emu test window</Text>
	<Style_VScroll>false</Style_VScroll>
	<Style_HScroll>false</Style_HScroll>
	<Style_Transparent>false</Style_Transparent>
	<DrawTemplate>WDT_Rounded</DrawTemplate>
	<Style_Titlebar>true</Style_Titlebar>
	<Style_Closebox>true</Style_Closebox>
	<Style_Minimizebox>false</Style_Minimizebox>
	<Style_Border>true</Style_Border>
	<Style_Sizable>false</Style_Sizable>
	<Pieces>RTW_Label</Pieces>
	<Pieces>RTW_Input</Pieces>
	<Pieces>RTW_Button</Pieces>
</Screen>
</XML>
